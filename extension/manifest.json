{
  "manifest_version": 3,
  "name": "SpoilFree",
  "version": "1.2",
  "description": "Blurs potential spoiler content on web pages using an AI-powered detection API.",
  "host_permissions": [
    "https://salujadivyam-spoilfree.hf.space/*",
    "https://api.tvmaze.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "episode-parser.js",
        "series-matcher.js",
        "watchlist-manager.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "exclude_matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://web.whatsapp.com/*",
        "https://*.paypal.com/*",
        "https://docs.google.com/*",
      "https://drive.google.com/*",
          "https://*.notion.so/*",
          "https://app.slack.com/*",
          "https://discord.com/*",
          "https://web.telegram.org/*"
      ],
      "match_about_blank": false
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
